#create an IP Address Manager that identifies suspicious IPs

#create "suspicious" IP addresses based on certain criteria 
ip_addresses = ["192.168.1.100", "10.0.0.50", "172.16.0.25", "192.168.0.20", "10.0.0.15"]

#display the first IP address 
print("The first IP address:", ip_addresses[0])

#Display the last IP Address 
print("The last IP address:", ip_addresses[-1])

#ask the user for an IP address to check if it is suspicious

new_ip = input("Enter a new suspicious IP address to check: ")

#Add the new IP address to the list of suspicious IPs
ip_addresses.append(new_ip)

print("Updated list of suspicious IP list:", ip_addresses)

#ask which position the user wants to change
position = int(input("Enter the position of the IP address you want to change (0-5): "))

#ask for the replacement IP address
replacement_ip = input("Enter the new IP address: ")
ip_addresses[position] = replacement_ip
print("Updated IP list:", ip_addresses)

#ask the user which IP address they want to remove
remove_ip = input("Enter the IP address you want to remove: ")

#check if the IP address is in the list and remove it

if remove_ip in ip_addresses:
    ip_addresses.remove(remove_ip)
    print("IP Address removed succesfully:")
else:
    print("IP Address not found in the list.")
print("Updated IP list:", ip_addresses)

#display thge total number of IPs
print("Total number of suspicious IP addresses:", len(ip_addresses))

#ask the user which IP address they want to search for
search_ip = input("Enter IP address to search for: ")

#check if the IP address exists in the list 
if search_ip in ip_addresses:
    print("IP address found in the list.")
else:
    print("IP address not found in the list.")
