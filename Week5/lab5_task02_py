#create a tuple of security incident details

incident = ("Joe Bloggs", "192.168.1.100", "Failed Login", "High")          

#display items individually

print("Username:", incident[0])
print("IP address:", incident[1])
print("Event Type:", incident[2])
print("Severity Level:", incident[3])

#display the number of items in the tuple
print("Number of elements:", len(incident))

#check whether an event type exists in the tuple
event= input("Enter an event type to search for: ")

if event in incident:
    print("Event type found in the tuple.")
else:
    print("Event type not found in the tuple.")

#try to change an item in the tuple (this will raise an error)
#tuples cannot be changed after they are created, so the following line will raise an error

try:
    incident[0] = "Jane Bloggs"
except TypeError:
    print("Tuples cannot be modified.")

#display the tuple
print("Security incident record:", incident)
