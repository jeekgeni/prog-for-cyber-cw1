

ip_addresses = [
    "192.168.1.100",
    "10.0.09.50",
    "172.16.0.25",
    "192.169.1.100",
    "10.0.0.15",
    "10.0.0.50",
    "192.168.0.20"
]

unique_ips = set(ip_addresses)

print("\n=========== UNIQUE IP ADDRESSES ===========")
for ip in unique_ips:
    print(ip)

remove_ip = input("\nEnter an IP address to remove from the list: ")

#check whether the IP address is in the set and remove it

if remove_ip in unique_ips:
    unique_ips.remove(remove_ip)
    print("-IP Address removed successfully")
else:
    print("IP Address not found in the set.")

#display updated set of IPs
print("\n=========IP Address Set ==========")

for ip in unique_ips:
    print(ip)

search_ip = input("\nEnter an IP Address to search for: ")

if search_ip in unique_ips:
    print("IP address not found in the set.")

print("\n========== TOTAL UNIQUE IP ADDRESSES =========")
print("Total number of unique IP Addresses:", len(unique_ips))

print("\n ========== END OF IP ADDRESS REPORT ========")

